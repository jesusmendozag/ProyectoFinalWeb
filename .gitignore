# ── Dependencias (se instalan con npm install, nunca se suben) ──
node_modules/

# Instalación local de Claude Code en la raíz (no es parte del sitio)
/package.json
/package-lock.json

# ── Secretos y variables de entorno (en cualquier carpeta) ──
.env
.env.*
!.env.example
*.pem
*.key
*.p12
*.pfx
*.keystore
*.jks
credentials*.json
secrets*.json

# Configuración local de herramientas (puede contener permisos o rutas personales)
.claude/settings.local.json
.impeccable/config.local.json

# ── Registros y temporales ──
npm-debug.log*
yarn-debug.log*
yarn-error.log*
*.log
.DS_Store
Thumbs.db
desktop.ini

# ── Editor ──
.vscode/*
!.vscode/extensions.json
.idea/
